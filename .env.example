# =============================================================================
# Raqmi Dawam — Example Environment Configuration
# -----------------------------------------------------------------------------
# PLACEHOLDERS ONLY. Never put real credentials, API keys, passwords, tokens,
# private URLs, or secrets in this file. Copy this to `.env` locally and fill in
# real values there. `.env` is git-ignored and must never be committed.
#
# NOTE: The application is not implemented yet (planning/documentation phase).
# These keys reflect the approved stack (Laravel + PostgreSQL + Redis + React)
# and are indicative; they will be finalized when Sprint 0 is implemented.
# =============================================================================

# --- Application ---
APP_NAME="Raqmi Dawam"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
# Supported locales and default (Arabic RTL / English LTR are both mandatory)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,ar

# --- Multi-tenancy ---
# Base domain used to resolve tenants from subdomains (e.g. company.example.test)
TENANT_BASE_DOMAIN=raqmidawam.test
# Central/landlord domain for the Super Admin portal
CENTRAL_DOMAIN=admin.raqmidawam.test

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=raqmi_dawam
DB_USERNAME=raqmi
DB_PASSWORD=__CHANGE_ME__
# Enforce PostgreSQL Row-Level Security for tenant isolation (see ARCHITECTURE.md)
DB_ENABLE_RLS=true

# --- Cache / Queue / Session (Redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- Mail (notifications) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (S3-compatible) ---
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Authentication / tokens ---
# Placeholder settings for API token / session auth (values set locally only)
AUTH_TOKEN_TTL_MINUTES=60
AUTH_REFRESH_TTL_MINUTES=20160
MFA_ENABLED=false

# --- Payment Gateway abstraction (ADR-010) ---
# Provider-agnostic. Online integration is deferred to a later sprint.
# Select the active driver; keep provider credentials in local .env only.
PAYMENT_GATEWAY_DRIVER=manual
PAYMENT_CARD_PROVIDER=
PAYMENT_CARD_API_KEY=
PAYMENT_CARD_WEBHOOK_SECRET=

# --- AI Provider abstraction (ADR-011) ---
# Provider-agnostic. No provider is integrated yet. Business logic must never
# depend directly on a single AI provider.
AI_PROVIDER_DRIVER=null
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=

# --- Frontend (React SPA) ---
# Public base URL of the API the SPA calls (safe, non-secret placeholder).
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost/api/v1

# --- Logging / observability ---
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Compliance (GDPR-ready seams — ADR-013) ---
# Default data retention (days) for policy-driven cleanup; refine per data class.
DATA_RETENTION_DEFAULT_DAYS=365
