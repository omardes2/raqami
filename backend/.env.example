APP_NAME="Raqmi Dawam"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Arabic (RTL) + English (LTR) are mandatory from Sprint 0 (ADR-012).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_SUPPORTED_LOCALES=en,ar

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- PostgreSQL (ADR-003) ---
# The application DB role MUST be a non-superuser without BYPASSRLS so that
# Row-Level Security actually protects tenants. Never commit real credentials.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=raqmi_dawam
DB_USERNAME=raqmi
DB_PASSWORD=__CHANGE_ME__
DB_ENABLE_RLS=true

# --- Sessions / cache / queue on Redis (ADR-005) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# First-party SPA (Sanctum) stateful domains.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
# Comma-separated origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@raqmidawam.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (S3-compatible, ADR-006) — placeholders only ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Payment Gateway abstraction (ADR-010) — NO integration in Sprint 0 ---
PAYMENT_GATEWAY_DRIVER=manual

# --- AI Provider abstraction (ADR-011) — NO integration in Sprint 0 ---
AI_PROVIDER_DRIVER=null
# Anthropic Claude driver (only used when AI_PROVIDER_DRIVER=anthropic). Key is
# server-side only and never exposed to the frontend. Leave empty to keep AI off.
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-sonnet-5
# Optional usage-ledger cost estimate (micro-USD per token; 0 = unknown)
AI_COST_MICRO_PER_INPUT_TOKEN=0
AI_COST_MICRO_PER_OUTPUT_TOKEN=0
# Per-tenant daily AI call cap (0 = unlimited)
AI_DAILY_CALL_CAP=500

# --- GDPR-ready foundation (ADR-013) ---
DATA_RETENTION_DEFAULT_DAYS=365

# --- Local Super Admin seed (dev only; never real credentials) ---
PLATFORM_ADMIN_EMAIL=superadmin@raqmidawam.test
PLATFORM_ADMIN_NAME="Platform Super Admin"
PLATFORM_ADMIN_PASSWORD=__CHANGE_ME__

VITE_APP_NAME="${APP_NAME}"
